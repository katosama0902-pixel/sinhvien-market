# Cấu hình môi trường frontend — KHÔNG chứa secret/key nào.
# Sao chép thành .env.local rồi chỉnh theo nhu cầu.

# true  = dùng API giả (mock) với tài khoản demo, không cần backend
# false = gọi backend thật tại NEXT_PUBLIC_API_URL (cookie httpOnly, credentials: 'include')
NEXT_PUBLIC_USE_MOCK=true

# Địa chỉ backend Node.js (chỉ dùng khi NEXT_PUBLIC_USE_MOCK=false)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
