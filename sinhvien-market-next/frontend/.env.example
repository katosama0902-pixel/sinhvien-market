# Cấu hình môi trường frontend — KHÔNG chứa secret/key nào.
# Sao chép thành .env.local rồi chỉnh theo nhu cầu.

# true  = dùng API giả với tài khoản demo, không cần backend
# false = gọi API PHP qua rewrite /api (các endpoint phải được triển khai tương ứng)
NEXT_PUBLIC_USE_MOCK=true

# Giữ nguyên /api để request cùng origin qua Next.js rewrite.
NEXT_PUBLIC_API_URL=/api

# URL gốc của ứng dụng PHP MVC, không kết thúc bằng dấu gạch chéo.
# Chỉnh lại theo địa chỉ Apache/Laragon/XAMPP đang dùng.
PHP_BACKEND_URL=http://localhost/sinhvien-market-php
