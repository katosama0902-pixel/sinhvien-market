# 1. Google AI Studio API Keys cho Gemini Embedding 2
# Có thể điền 1 hoặc nhiều key cách nhau bởi dấu phẩy để tự động xoay vòng & tránh giới hạn rate-limit:
GEMINI_API_KEYS=
# (Hoặc dùng biến đơn GEMINI_API_KEY=...)
GEMINI_MODEL=gemini-embedding-2
GEMINI_OUTPUT_DIM=768

# 2. Cấu hình Jina-CLIP-v2 (hỗ trợ 2 chế độ: 'api' hoặc 'local')
# - 'api'  : Gọi trực tiếp Jina Embeddings API (nhanh, không cần tải 1.8GB model, 10M token miễn phí tại https://jina.ai/embeddings/)
# - 'local': Chạy cục bộ jinaai/jina-clip-v2 bằng PyTorch/Transformers (nên kèm HF_TOKEN để tránh lỗi 429 tải model từ Hugging Face)
JINA_MODE=auto
JINA_API_KEY=
HF_TOKEN=
JINA_OUTPUT_DIM=1024
